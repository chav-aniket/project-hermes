---
import { pwaInfo } from "virtual:pwa-info";

import ReloadPrompt from "@astroComponents/ReloadPrompt.astro";
import { initThemeScript } from "@utils/theme";

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Aniket's Observatorium" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#ea580c" />
    <!-- Theme color - dynamically updated by theme.ts -->
    <meta name="theme-color" content="#fed7aa" />
    <!-- iOS PWA status bar -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <script src="../pwa.ts"></script>
    <script set:html={initThemeScript} />
    <script>
      import { inject } from "@vercel/analytics";
      inject({ mode: import.meta.env.MODE });
    </script>
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <main>
      <slot />
    </main>
    <ReloadPrompt />
  </body>
</html>
<style is:global>
  :root {
    /* Theme colors - synced with src/config/theme.ts */
    --theme-bg: theme(colors.primary.light);
    --theme-tertiary: theme(colors.tertiary.light);

    /* Transition timing - synced with src/config/theme.ts TIMING */
    --phase-duration: 600ms;
    --shadow-in-duration: 400ms;
    --melt-duration: 300ms;

    /* Shadows for light theme */
    --text-shadow: 0 6px 20px rgb(0 0 0 / 0.6), 0 2px 8px rgb(0 0 0 / 0.4);
    --box-shadow: 0 12px 40px rgb(0 0 0 / 0.5), 0 4px 12px rgb(0 0 0 / 0.3);

    /* Default animation timing (overridden by phase classes) */
    --shadow-duration: var(--phase-duration);
    --shadow-easing: ease-out;
  }

  html.dark {
    --theme-bg: theme(colors.primary.dark);
    --theme-tertiary: theme(colors.tertiary.dark);
    --text-shadow: 0 6px 20px rgb(255 255 255 / 0.5), 0 2px 8px rgb(255 255 255 / 0.3);
    --box-shadow: 0 12px 40px rgb(255 255 255 / 0.4), 0 4px 12px rgb(255 255 255 / 0.2);
  }

  html {
    font-family: "JetBrains Mono", monospace;
    background-color: var(--theme-bg);
    position: relative;
    box-sizing: border-box;
  }

  :is(a, input):focus {
    outline: none;
  }

  /*
   * Theme shadow elements - use [data-theme-shadow] attribute
   * Default state: no shadows. Shadows only appear during animation phases.
   */
  [data-theme-shadow="box"] {
    transition: box-shadow var(--shadow-duration) var(--shadow-easing);
    box-shadow: none;
  }

  [data-theme-shadow="text"] {
    transition: text-shadow var(--shadow-duration) var(--shadow-easing);
    text-shadow: none;
  }

  /* Phase 1: Shadows appear */
  html.theme-shadow-in {
    --shadow-duration: var(--shadow-in-duration);
    --shadow-easing: ease-out;
  }

  html.theme-shadow-in [data-theme-shadow="box"] {
    box-shadow: var(--box-shadow);
  }

  html.theme-shadow-in [data-theme-shadow="text"] {
    text-shadow: var(--text-shadow);
  }

  /* Phase 2a: Content melts */
  html.theme-melt main {
    transition: opacity var(--melt-duration) ease-in, filter var(--melt-duration) ease-in;
    opacity: 0;
    filter: blur(16px);
  }

  html.theme-melt {
    --shadow-duration: var(--melt-duration);
    --shadow-easing: ease-in;
  }

  html.theme-melt [data-theme-shadow="box"] {
    box-shadow: none;
  }

  html.theme-melt [data-theme-shadow="text"] {
    text-shadow: none;
  }

  /* Phase 2b: Hidden during sweep */
  html.theme-hidden main {
    opacity: 0;
    filter: blur(16px);
    visibility: hidden;
  }

  /* Phase 3: Content emerges */
  html.theme-unmelt main {
    transition: opacity var(--phase-duration) ease-out, filter var(--phase-duration) ease-out;
    opacity: 1;
    filter: blur(0);
  }

  html.theme-unmelt {
    --shadow-duration: var(--phase-duration);
    --shadow-easing: ease-out;
  }

  html.theme-unmelt [data-theme-shadow="box"] {
    box-shadow: var(--box-shadow);
  }

  html.theme-unmelt [data-theme-shadow="text"] {
    text-shadow: var(--text-shadow);
  }

  /* Phase 4: Shadows recede */
  html.theme-shadow-out {
    --shadow-duration: var(--phase-duration);
    --shadow-easing: ease-in;
  }

  html.theme-shadow-out [data-theme-shadow="box"] {
    box-shadow: none;
  }

  html.theme-shadow-out [data-theme-shadow="text"] {
    text-shadow: none;
  }

  /* Toggle excluded from shadows */
  [data-theme-toggle],
  [data-theme-toggle] * {
    text-shadow: none !important;
    box-shadow: none !important;
  }

  /* Theme reveal overlay (cloned content for wave animation) */
  #theme-reveal-overlay {
    position: fixed;
    inset: 0;
    overflow: hidden;
    z-index: 9998;
    pointer-events: none;
  }

  /* Mobile: add background color */
  @media (max-width: 767px) {
    #theme-reveal-overlay {
      background: var(--theme-bg);
    }
  }

  code {
    font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
      DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
  }

  /* Reusable hover utilities */
  .hover-scale {
    @apply transition-all duration-300 ease-out;
  }
  .hover-scale:hover {
    @apply scale-105;
  }

  .hover-scale-lg {
    @apply transition-all duration-300 ease-out;
  }
  .hover-scale-lg:hover {
    @apply scale-110 opacity-80;
  }

  .hover-glow {
    @apply transition-colors duration-300;
  }
  .hover-glow:hover {
    background-color: var(--theme-tertiary);
  }
</style>
