    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^1.6.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.18.2",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.7",
    "tailwindcss": "^4.3.3",
